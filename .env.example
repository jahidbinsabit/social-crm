# ─────────────────────────────────────────────
# Social CRM — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit the .env file to version control.
# ─────────────────────────────────────────────

APP_NAME="Social CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ───────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social_crm
DB_USERNAME=root
DB_PASSWORD=

# ─── Session / Cache / Queue ────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail (default: log driver) ─────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Laravel Reverb (WebSocket) ─────────────
REVERB_APP_ID=social-crm-app
REVERB_APP_KEY=social-crm-key
REVERB_APP_SECRET=social-crm-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Messaging Engine URLs ──────────────────
WA_ENGINE_URL=http://127.0.0.1:3001
TG_ENGINE_URL=http://127.0.0.1:3002

# ─── Internal API Secret ────────────────────
# Shared secret between Laravel ↔ WhatsApp/Telegram engines.
# Generate with: php artisan tinker --execute="echo bin2hex(random_bytes(32));"
INTERNAL_API_SECRET=
